# Copie para .env e preencha. O .env NUNCA vai para o repositório.
# App ID e App Certificate: Agora Console > seu projeto (ou: agora project env)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Região da API da Agora (US, EU, AP). US é o padrão dos exemplos oficiais.
AGORA_AREA=US

# Opcional: chave do LemonSlice para o cenário de avatar (https://lemonslice.com)
LEMONSLICE_API_KEY=

# Avatar da Anam (cole a chave voce mesmo)
ANAM_API_KEY=
ANAM_AVATAR_ID=
