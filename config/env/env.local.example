# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Homework reading: OpenAI vision analysis of uploaded photos/PDFs (server-side only)
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini. Also part of the material cache key.
# HOMEWORK_VISION_MODEL=gpt-4.1-mini

# Uploaded file and extracted-content retention. Defaults to seven days.
LUMI_MATERIAL_RETENTION_HOURS=168

# Optional: needed when a child chooses a LemonSlice avatar other than the default Plush.
# NEXT_LEMONSLICE_API_KEY=
# Optional dashboard override for the Explorer/alien avatar.
# NEXT_LEMONSLICE_AGENT_ID=
