# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Feita multimodal text extraction (server-side only)
FEITA_AI_API_KEY=
FEITA_AI_MODEL=anthropic/claude-opus-5.5
FEITA_AI_URL=https://api.feita.ai/gateway/v1/chat/completions

# Uploaded image and extracted-text retention. Defaults to seven days.
LUMI_MATERIAL_RETENTION_HOURS=168
